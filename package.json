{
  "name": "tashtech-portal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bun --bun next dev --turbopack -p 3000",
    "build": "bun --bun next build",
    "start": "bun --bun next start -p 3000",
    "db:up": "docker compose up -d",
    "db:migrate": "bun scripts/migrate.ts",
    "db:seed": "bun scripts/seed.ts",
    "db:reset": "bun scripts/migrate.ts --reset && bun scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "smoke": "bun scripts/smoke.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.77.0",
    "next": "15",
    "pdfkit": "^0.21.0",
    "postgres": "^4.1.1",
    "react": "19",
    "react-dom": "19",
    "recharts": "^3.11.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "^1.4.5",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6"
  }
}